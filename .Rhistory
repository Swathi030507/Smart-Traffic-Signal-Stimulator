if (emergency_found == TRUE) {
cat("\n====================================\n")
cat(" EMERGENCY CLEARED\n")
cat("====================================\n")
cat("\nReturning to normal traffic scheduling...\n")
highest_traffic <- which.max(vehicles)
cat(
"\nHighest traffic road:",
roads[highest_traffic],
"\n"
)
cat("\nNormal Signal Schedule:\n")
for (i in 1:length(roads)) {
if (i == highest_traffic) {
cat(
roads[i],
"→ GREEN (",
green_time[i],
"seconds )\n"
)
} else {
cat(
roads[i],
"→ RED\n"
)
}
}
}
cat("\nHighest traffic road:",
roads[highest],
"with", vehicles[highest], "vehicles.\n")
cat("Green time:",
green_time[highest],
"seconds\n")
install.packages("shiny")
library(shiny)
runApp('smart_traffic_signal.R')
runApp('smart_traffic_signal.R')
